REDIS_PASSWORD=change_me_local

# JWT (requis — doit faire au moins 32 caractères)
JWT_SECRET=dev-secret-key-minimum-32-characters-local

# SendGrid (optionnel en dev — laisser vide pour désactiver les emails)
SENDGRID_API_KEY=

