# AfriPay API — Nginx HTTP (bootstrap pre-SSL)
# Généré par Ansible — sera remplacé par la config HTTPS après certbot

limit_req_zone $binary_remote_addr zone=api_limit:10m rate=100r/s;

upstream afripay_api {
    server 127.0.0.1:{{ app_port }};
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ domain_api }};

    # Validation certbot (ACME challenge)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Proxy HTTP direct (temporaire — avant SSL)
    location / {
        limit_req zone=api_limit burst=200 nodelay;

        proxy_pass         http://afripay_api;
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_connect_timeout  10s;
        proxy_send_timeout     60s;
        proxy_read_timeout     60s;
    }

    location = /health {
        proxy_pass http://afripay_api/health;
        access_log off;
    }

    location /docs {
        proxy_pass http://afripay_api/docs;
    }

    server_tokens off;
    access_log /var/log/nginx/afripay-api-access.log combined;
    error_log  /var/log/nginx/afripay-api-error.log warn;
}