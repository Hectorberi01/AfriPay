#  .env — AfriPay Production
#  Généré par Ansible le {{ ansible_date_time.iso8601 }}
#    NE PAS VERSIONNER CE FICHIER

# Docker Images 
IMAGE_TAG={{ image_tag }}

# ASP.NET Core 
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:{{ app_port }}

# PostgreSQL
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_LIVE_DB={{ postgres_live_db }}
POSTGRES_SAND_DB={{ postgres_sand_db }}

# Redis 
REDIS_PASSWORD={{ vault_redis_password }}

# JWT 
JWT_SECRET={{ vault_jwt_secret }}

# SendGrid 
SENDGRID_API_KEY={{ vault_sendgrid_api_key }}

# MTN MoMo 
MTN_LIVE_SUBSCRIPTION_KEY={{ vault_mtn_live_subscription_key }}
MTN_SANDBOX_SUBSCRIPTION_KEY={{ vault_mtn_sandbox_subscription_key }}

# PayPal
PAYPAL_LIVE_CLIENT_ID={{ vault_paypal_live_client_id }}
PAYPAL_LIVE_SECRET={{ vault_paypal_live_secret }}
PAYPAL_SANDBOX_CLIENT_ID={{ vault_paypal_sandbox_client_id }}
PAYPAL_SANDBOX_SECRET={{ vault_paypal_sandbox_secret }}

# Stripe
STRIPE_LIVE_SECRET_KEY={{ vault_stripe_live_secret_key }}
STRIPE_TEST_SECRET_KEY={{ vault_stripe_test_secret_key }}

# Grafana
GRAFANA_PASSWORD={{ vault_grafana_admin_password }}

# Slack 
SLACK_WEBHOOK_URL={{ vault_slack_webhook_url }}